# Copy to backend/.env and fill in. The Vercel functions (also under `vercel dev`) and the legacy
# server read this file. Real environment variables win.
GEMINI_API_KEY=

# Model IDs (these drift; check https://ai.google.dev/gemini-api/docs/models)
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-3.6-flash
LIVE_VOICE=Kore
# API version for ephemeral tokens and the browser's Live connection (Google's docs: v1beta only)
GEMINI_LIVE_API_VERSION=v1beta

# Neon Postgres. `vercel env pull .env.local` writes it for `vercel dev`.
DATABASE_URL=

# Guardrails
MAX_SESSION_MINUTES=45
SESSION_GRACE_MINUTES=3
MAX_SESSIONS_PER_IP=2

# Debugging track: run candidate Python locally (not a security sandbox; see README)
CODE_EXECUTION_ENABLED=true
# sandbox (Vercel Sandbox microVM per run; needs VERCEL_OIDC_TOKEN from `vercel env pull`) | local
# (child process, development only; refused on Vercel deployments)
CODE_RUNNER=sandbox
CODE_RUN_TIMEOUT_SECONDS=6
MAX_RUNS_PER_SESSION=20

# Legacy server only ------------------------------------------------------------------------
# gemini_live (default) | fake (no API calls; scripted interviewer) | pipeline_local (server mic/speakers)
VOICE_BACKEND=gemini_live
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173"]
PORT=5100
LOG_LEVEL=INFO
# pipeline_local only: absolute paths to the intro/outro clips
INTRO_PATH=
END_PATH=
