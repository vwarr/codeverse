# Copy to backend/.env and fill in.
GEMINI_API_KEY=

# Model IDs (these drift; check https://ai.google.dev/gemini-api/docs/models)
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-3.5-flash
LIVE_VOICE=Kore

# gemini_live (default) | fake (no API calls; scripted interviewer) | pipeline_local (legacy server mic/speakers)
VOICE_BACKEND=gemini_live

# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173"]
PORT=5100
LOG_LEVEL=INFO

# Guardrails
MAX_SESSION_MINUTES=45
MAX_SESSIONS_PER_IP=2

# pipeline_local only: absolute paths to the intro/outro clips
INTRO_PATH=
FINANCE_PATH=
END_PATH=
