# Copy to backend/.env and fill in.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
CORS_ORIGINS=http://localhost:5173
PORT=5100
FLASK_DEBUG=0

# Absolute paths to the intro/outro clips played on the server (Phase 0 only).
INTRO_PATH=/absolute/path/to/backend/audio_files/swe_intro.mp3
FINANCE_PATH=/absolute/path/to/backend/audio_files/finance_intro.mp3
END_PATH=/absolute/path/to/backend/audio_files/goodbye.mp3
