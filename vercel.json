{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/**/*.py": {
      "includeFiles": "backend/codeverse/**",
      "excludeFiles": "{backend/tests/**,backend/.venv/**,backend/audio_files/**,**/__pycache__/**}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
