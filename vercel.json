{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/**/*.py": {
      "includeFiles": "backend/codeverse/**",
      "excludeFiles": "{node_modules/**,.yarn/**,src/**,dist/**,design/**,test-utils/**,public/**,backend/tests/**,backend/.venv/**,backend/*.log,**/__pycache__/**,**/.pytest_cache/**,**/.ruff_cache/**,*.lock,package-lock.json}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
